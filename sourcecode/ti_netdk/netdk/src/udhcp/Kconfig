config TI_UDHCP
	bool "UDHCP Server & Client"
    depends on TI_NETDK
	select PACKET
	default y
	help
		Enable or Disable UDHCP

if TI_UDHCP
config TI_UDHCP_CLIENT
	bool "UDHCP Client"
	default n
	help
		Enable DHCP Client in UDHCP

config TI_UDHCP_SERVER
	bool "UDHCP Server"
	default y
	help
		Enable DHCP Server in UDHCP

endif

