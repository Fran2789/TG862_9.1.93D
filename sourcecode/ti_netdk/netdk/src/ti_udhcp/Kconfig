config TI_TIUDHCPC_T1_T2_OVERRIDE
	bool "Read DHCP_T1(58), DHCP_T2(59) options"
	depends on TI_TIUDHCP
	default n
	help
		When enabled, the DHCPv4 client parses the options 58 and 59 and sets the t1, t2 times for renewal and rebinding accordingly. Otherwise,by default, t1 is set to 0.5*lease and t2 is set to 0.875*lease.
endif
