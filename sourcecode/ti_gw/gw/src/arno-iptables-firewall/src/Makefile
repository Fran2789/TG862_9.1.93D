include $(COMPONENT_PREFIX)/build/gw_config.make 

PACKAGE_VERSION := 2.0.0a
PACKAGE_DIR := arno-iptables-firewall_$(PACKAGE_VERSION)
export PACKAGE_ABS_DIR := $(shell pwd)/$(PACKAGE_DIR)
#
# Final output target
#
# Select one (or more) targets to be generated from this Makefile:
#
# TARGET	- Binary executable file
# A_TARGET	- Static library file (.a file)
# SO_TARGET	- Shared library file (.so file)
# O_TARGET	- Object file (.o file)
#
TARGET := 

#
# Compilation options to add to the compiler (optional)
#
cflags-y :=  


#
# Link options to add to the linker (optional)
# e.g. ldflags-y := -lfoo
#
ldflags-y := 

#
# List of sub-directories to compile (if required)
# e.g. subdir-y := mymodule1/src mymodule2/src
#
subdir-y := c-arno-iptables-firewall/src

#
# List of objects to compile
#
# The list could be either automatically generated from the C files in the
# current directory by the following syntax:
#
# obj-y := $(AUTO_GENERATE_C_FILES)
#
# or manually generated by explicitly specifing each C file:
#
# obj-y := obj1.o obj2.o .... 
#
obj-y := 

#
# List of header files to install in the system include directory
#
# The list could be either automatically generated from the H files in the
# include directory by the following syntax:
#
# install_headers-y := $(AUTO_GENERATE_H_FILES)
#
# or manually generated by explicitly specifing each H file:
#
# install_headers-y := header1.h header2.h .... 
#
install_headers-y := 

#
# List of additional files to clean (excluding object files and targets)
#
clean-y := 

#
# Make rules include file (Do not remove!)
#
include $(COMPONENT_PREFIX)/build/rules.make      

#
# Additional module targets:
#

#
# Actions which require control here, before starting to build this module.
# If there is nothing to be done, this target should be left empty.
#
build_pre:
        
#
# Actions which require the control here, after this module has been built.
# If there is nothing to be done, this target should be left empty.
#
build_post:

#
# Target to install additional files
#
# Use the install command to copy additional files by the following syntax:
#
# @install -m 0755 <list of files> <destination directory>
#
# install_extra does not get executed when no TARGT* is defined, go directly to install_rule 
#
install_arno:
# Install the scripts, plugins and configuration files	
	@echo "Installing arno's firewall and iptables scripts"
	@install -m 0755 $(CURDIR)/$(PACKAGE_DIR)/bin/arno-iptables-firewall $(TI_filesystem_path)/usr/sbin/

	@mkdir -p $(TI_filesystem_path)/usr/local/share/arno-iptables-firewall/plugins
	@install -m 0644  $(CURDIR)/$(PACKAGE_DIR)/share/arno-iptables-firewall/environment $(TI_filesystem_path)/usr/local/share/arno-iptables-firewall/

	@mkdir -p $(TI_filesystem_path)/etc/arno-iptables-firewall
	@mkdir -p $(TI_filesystem_path)/etc/arno-iptables-firewall/plugins
	
	cp -rf $(CURDIR)/$(PACKAGE_DIR)/etc/arno-iptables-firewall/custom-rules $(TI_filesystem_path)/etc/arno-iptables-firewall
	# UNIHAN ADD START
ifdef CONFIG_VENDOR_COMCAST
	install -m 0644 $(CURDIR)/$(PACKAGE_DIR)/etc/arno-iptables-firewall/lowLevel-rules $(TI_filesystem_path)/etc/arno-iptables-firewall
	install -m 0644 $(CURDIR)/$(PACKAGE_DIR)/etc/arno-iptables-firewall/mediumLevel-rules $(TI_filesystem_path)/etc/arno-iptables-firewall
	install -m 0644 $(CURDIR)/$(PACKAGE_DIR)/etc/arno-iptables-firewall/highLevel-rules $(TI_filesystem_path)/etc/arno-iptables-firewall
	cd  $(TI_filesystem_path)/usr/www; ln -sf ../../../../var/tmp/getfwstatus getfwstatus;
endif
	# UNIHAN ADD END
#	install -m 0644 $(CURDIR)/$(PACKAGE_DIR)/etc/arno-iptables-firewall/firewall.conf $(TI_filesystem_path)/etc/arno-iptables-firewall/
#	install -m 0644 $(CURDIR)/firewall.conf $(TI_filesystem_path)/etc/arno-iptables-firewall/
	install -m 0644 $(CURDIR)/firewall.env $(TI_filesystem_path)/etc/arno-iptables-firewall/
	#not in use now @cp -rf $(CURDIR)/$(PACKAGE_DIR)/etc/arno-iptables-firewall/plugins/ $(TI_filesystem_path)/etc/arno-iptables-firewall
	
# Hai: Some hacks to make it work with busybox and uClibc 0.9.29
	@echo "echo 0" > $(TI_filesystem_path)/bin/id && chmod 755 $(TI_filesystem_path)/bin/id
	@if [ ! -f $(TI_filesystem_basefs_path)/sbin/modprobe ]; \
	       then echo "exit 0" > $(TI_filesystem_path)/sbin/modprobe &&\
	       chmod 755 $(TI_filesystem_path)/sbin/modprobe;\
	       fi
	@ln -sf /sbin/iptables $(TI_filesystem_path)/usr/bin/iptables
	@ln -sf /sbin/ip6tables $(TI_filesystem_path)/usr/bin/ip6tables
ifdef CONFIG_TI_IPROUTE2
	@ln -sf /usr/sbin/ip $(TI_filesystem_path)/sbin/ip
else
	@ln -sf /bin/busybox $(TI_filesystem_path)/sbin/ip
endif

install_rule: install_arno

uninstall_arno:
	@rm -rf $(TI_filesystem_path)/usr/local/share/arno-iptables-firewall
	@rm -rf $(TI_filesystem_path)/etc/arno-iptables-firewall
	@rm -rf $(TI_filesystem_path)/usr/sbin/arno*
	@rm -rf $(TI_filesystem_path)/var/custom-rules
	# UNIHAN ADD START
ifdef CONFIG_VENDOR_COMCAST
	@rm -rf $(TI_filesystem_path)/var/lowLevel-rules
	@rm -rf $(TI_filesystem_path)/var/mediumLevel-rules
	@rm -rf $(TI_filesystem_path)/var/highLevel-rules
endif
	# UNIHAN ADD END

uninstall_rule: uninstall_arno

