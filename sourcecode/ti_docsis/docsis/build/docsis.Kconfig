config SUPPORT_MXL_TUNERS
	bool "Support MXL tuners"
	depends	TI_DOCSIS
	default y
	help
	Turn this flag on in order to support MXL tuners

config SUPPORT_MT_TUNERS
	bool "Support MT tuners"
	depends	TI_DOCSIS
	default y
	help
	Turn this flag on in order to support MT tuners


config SUPPORT_NXP_TUNERS
	bool "Support NXP tuners"
	depends	TI_DOCSIS
	default y
	help
	Turn this flag on in order to support NXP tuners


config DOCSIS_NUM_OF_UPSTREAM
	int "Number of DOCSIS upstream channels supported"
	depends	TI_DOCSIS
	default 4
	range 4 8
	help
	Modify this flag only in Puma6 MG. Puma6 MG can support up to 8 DOCSIS upstream channels. 

config INTEL_SWDL_OPERATIONAL
    bool "Perform SW Download (cfg file) while Operational"
	depends	TI_DOCSIS
	default y
	help
        When this flag is on (== y), SW Download triggered by config file will 
        be performed while the CM is Operational, therefore CPE traffic is also 
        enabled during the SW Download. When this flag is off, SW Download 
        triggered by config file will be performed BEFORE the CM is operational, 
        therefore CPE traffic is disabled during SW Download


config SUPPORT_PWR_SPECTRUM
	bool "Support power spectrum"
	depends	TI_DOCSIS
	default y
	help
	Turn this flag on in order to support power spectrem measurement feature

