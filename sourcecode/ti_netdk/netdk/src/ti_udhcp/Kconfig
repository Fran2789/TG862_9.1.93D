config TI_TIUDHCP
	bool "TI DHCPv4 client"
	default y
	select PACKET
	help
		Enable or Disable TI DHCPv4 Client on the lan/wan side.

if TI_TIUDHCP
	
config TI_TIUDHCPC_MAX_OPTION_BUFSIZE
	int "Max length of options that can be sent/received by client"
	depends on TI_TIUDHCP
    range  308 1000
    default 308
	help
        This is the maximum size of option buffer, i.e. maximum size
        of options that can be sent/received by the client. By default,
        it is 308 bytes (min specified by RFC 2131).
	
config TI_TIUDHCPC_MAX_BACKOFF_TIME
	int "Max num of seconds to backoff for retransmission of DHCP discover/request/renew"
    depends on TI_TIUDHCP
    range  64 256
    default 64
    help
        This is the maximum time in seconds that the tiudhcpc would 
        backoff for retransmitting a DHCP discover/request/renew message.
        If the tiudhcpc doesnt recieve a response even after this time, the 
        config attempt is considered a failure. This number should be chosen
        with care and can be adjusted to suit your network.

config TI_TIUDHCPC_MAX_CONFIG_ATTEMPTS_THRESHOLD
	int "Max num of config attempts threshold"
    depends on TI_TIUDHCP
    range 3 10
    default 5
    help
		tiudhcpc reports an error to the plugin when this number
		of config attempts have been completed and there is no response
		from any server.

config TI_TIUDHCPC_RESTART_DELAY
	int "Delay between successive configuration attempts"
	depends on TI_TIUDHCP
	range 5 15
	default 10
	help
		This is the delay in seconds between successive config attempts
		by the tiudhcpc.

config TI_TIUDHCPC_OPT_TIMESVR
	bool "Time Server DHCP option support in TIUDHCPC"
	depends on TI_TIUDHCP
	default y
	help
		Set this to y if time server DHCP option handling is required in
		in TIUDHCPC core. opt code is 0x04
		
config TI_TIUDHCPC_OPT_COOKIESVR
