-include $(TARGET_HOME)/.config
ifeq ($(CONFIG_TI_VOICE_NCSDK),y)
export TI_MASDK_CFLAGS_EXTRA:=-DBUILD_MGCP=1
export TI_MASDK_CFLAGS_EXTRA+=-DHAS_DLM=1
export TI_MASDK_CFLAGS_EXTRA+=-I$(TI_base)/ti/include/ncsdk
endif

ifeq ($(CONFIG_TI_VOICE_DQM),y)
export TI_MASDK_CFLAGS_EXTRA+=-DVOICE_CLIENT_DQM_SUPPORT=1
export TI_MASDK_CFLAGS_EXTRA+=-I$(TI_base)/ti/include/common_voice_utils
endif

ifeq ($(CONFIG_MIPS_UR8EVM),y)
export MASDK_PFORM=ur8evm
endif

ifeq ($(CONFIG_MACH_PUMA5),y)
export MASDK_PFORM=puma
endif

ifeq ($(CONFIG_MACH_PUMA6),y)
export MASDK_PFORM=puma
endif

TI_NCSDK_ROOT?=$(TI_base)/ti/ncsdk
TI_NCSDK_BUILD_DIR=$(TI_NCSDK_ROOT)/build/$(RTOS)

export TI_FS_MASDK_KERNEL_DRIVER_PATH?=$(TI_filesystem_path)$(TI_kerneldriverdir)
export TI_FS_MASDK_DSP_PATH?=$(TI_filesystem_path)$(TI_rlibdir)
export TI_FS_MASDK_SCRIPT_PATH?=$(TI_filesystem_path)$(TI_vopdir)
export TI_FS_MASDK_APP_PATH?=$(TI_filesystem_path)$(TI_sbindir)
export TI_FS_INIT_SCRIPT_PATH?=$(TI_filesystem_path)$(TI_scriptsdir)

TI_NCSDK_START_SCRIPT_SOURCE?=$(TI_NCSDK_BUILD_DIR)/voice_start
TI_NCSDK_STOP_SCRIPT_SOURCE?=$(TI_NCSDK_BUILD_DIR)/voice_stop

TI_FS_MASDK_PCD_SCRIPT_DEST_TMP?=$(TI_FS_INIT_SCRIPT_PATH)/tmp


export TI_MASDK_INSTALL_KERNEL_MODULES?=1

ifeq ($(CONFIG_TI_VOICE_NCSDK),y)
export TI_MASDK_INSTALL_SCRIPTS?=1
endif

$(MASDK_PFORM)_scripts:
	$(REPORT) "Installing Voice PCD Scripts" 
	install -m 0755 $(TI_MASDK_PCD_SCRIPT_SOURCE) $(TI_FS_MASDK_PCD_SCRIPT_DESTINATION)
ifeq ($(CONFIG_TI_MASDK_SVCA),y)
	install -m 0755 $(TI_MASDK_PCD_SCRIPT_SOURCE) $(TI_FS_MASDK_PCD_SCRIPT_DEST_TMP) 
	sed 's/PROCESS_READY/NONE/' $(TI_FS_MASDK_PCD_SCRIPT_DEST_TMP) > $(TI_FS_MASDK_PCD_SCRIPT_DESTINATION)
	sed 's/5000/-1/' $(TI_FS_MASDK_PCD_SCRIPT_DESTINATION) > $(TI_FS_MASDK_PCD_SCRIPT_DEST_TMP)
	sed 's/REBOOT/NONE/' $(TI_FS_MASDK_PCD_SCRIPT_DEST_TMP) > $(TI_FS_MASDK_PCD_SCRIPT_DESTINATION)
	$(QUIET_CMD)$(RM) $(TI_FS_MASDK_PCD_SCRIPT_DEST_TMP) 
endif
	install -m 0755 $(TI_MASDK_SETUP_SCRIPT_SOURCE) $(TI_FS_MASDK_SETUP_SCRIPT_DESTINATION)
	install -m 0755 $(TI_MASDK_STOP_SCRIPT_SOURCE) $(TI_FS_MASDK_STOP_SCRIPT_DESTINATION)
