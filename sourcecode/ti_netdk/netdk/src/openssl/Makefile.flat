# Include this file that contains definitions.
-include $(TARGET_HOME)/TI_Build.make
-include $(TARGET_HOME)/.config

TI_uclibc_base = $(TARGET_HOME)/ti

CONFIG_TI_SSLTYPE := linux-generic32

ifdef USER_OPENSSL_CFLAGS
   CONFIG_TI_SSLOPTS = $(USER_OPENSSL_CFLAGS)
else
   CONFIG_TI_SSLOPTS += no-bf no-cast no-idea no-rc2 no-rc4 no-rc5 no-dsa no-md2 no-md4 no-mdc2 no-ripemd no-engines \
   no-camellia no-capieng no-cms no-gmp no-jpake no-krb5 no-tlsext
endif
CONFIG_TI_SSLOPTS += -D_FILE_OFFSET_BITS no-hw no-sse2 no-montasm no-rfc3779 no-seed no-zlib no-zlib-dynamic no-test

ifdef CONFIG_ARM_THUMB
CONFIG_TI_SSLOPTS += -mthumb -mthumb-interwork
endif

ifdef CONFIG_CPU_LITTLE_ENDIAN
CONFIG_TI_SSLOPTS += -DL_ENDIAN
else
CONFIG_TI_SSLOPTS += -DB_ENDIAN
endif

ifdef CONFIG_TI_SSL_SHARED
   CONFIG_TI_SSLOPTS+= shared
else
   CONFIG_TI_SSLOPTS+= no-shared
endif

CONFIG_TI_SSLOPTS+=-ffunction-sections -fdata-sections

MAKES= \
./apps/Makefile \
./crypto/Makefile \
./crypto/aes/Makefile \
./crypto/asn1/Makefile \
./crypto/bf/Makefile \
./crypto/bio/Makefile \
./crypto/bn/Makefile \
./crypto/buffer/Makefile \
./crypto/camellia/Makefile \
./crypto/cast/Makefile \
./crypto/cms/Makefile \
