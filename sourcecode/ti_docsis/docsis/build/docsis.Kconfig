config TI_DOCSIS
	bool "DOCSIS component"
	default y
        select TI_SSL
	select TI_SHMDB
	select TI_ICC
	select TI_TLVPARSER
	select TI_STATEMACHINE
	select TI_NVM
        select TI_PCD

	help
	Enable DOCSIS support

config TI_DOCSIS_DEBUG
	bool "Debug mode"
	depends	TI_DOCSIS
	default n

config TI_DOCSIS_MAC14
	bool "MAC14 image"
	depends	TI_DOCSIS
	default n

config TI_DOCSIS_BPI23
	bool "BPI23 image"
	depends	TI_DOCSIS
	default n

